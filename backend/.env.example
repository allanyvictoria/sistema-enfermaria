# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" de verdade para o GitHub.

# String de conexão do banco PostgreSQL.
# Local:    postgresql://postgres:SENHA@localhost:5432/enfermaria_db
# Supabase/Neon: copie a "Connection string" do painel do provedor.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Chave secreta usada para assinar os tokens de login (JWT).
# Gere uma chave forte e aleatória, por exemplo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-forte

# Origens (URLs) que podem chamar a API. Separe por vírgula se houver mais de uma.
# Em desenvolvimento local pode deixar "*". Em produção, use a URL real do frontend.
# Exemplo: ALLOWED_ORIGINS=https://enfermaria.netlify.app
ALLOWED_ORIGINS=*
